


import gymnasium as gym
import numpy as np
import random


alpha = 0.5
gamma = 0.99
episodes = 500
epsilon = 0.1


# Q-table => store Q-values

Q = np.zeros((48,4))


# Policy - E-greedy: state -> action

def epsilon_greedy(state):
    if random.random() < epsilon:
        return env.action_space.sample() # random action => Explore
    else:
        return np.argmax(Q[state]) # Exploit


for episode in range(episodes):

    env = gym.make("CliffWalking-v1")

    done = False # when episode has ended
    state, _ = env.reset()

    total_reward = 0
    episode_len = 0

    while not done:
        
        action = epsilon_greedy(state)
        
        next_state, reward, terminated, truncated, _ = env.step(action)
        done = terminated or truncated

        # Q-learning update
        Q[state, action] += alpha * (reward + gamma* np.max(Q[next_state]) - Q[state, action])

        state = next_state

        total_reward += reward
        episode_len += 1

    print(f"episode= {episode+1}/{episodes}: total reward = {total_reward} & ep length = {episode_len}")
    env.close()



